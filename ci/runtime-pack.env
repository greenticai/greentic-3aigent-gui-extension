# The runtime .gtpack that actually delivers messages. Built and published from
# greenticai/greentic-messaging-providers; this repo only embeds it.
#
# Pin an exact version — `stable` moves, and a release that silently changes
# its runtime is not reproducible.
RUNTIME_PACK_REF=ghcr.io/greenticai/packs/messaging/messaging-3aigent-gui
RUNTIME_PACK_VERSION=0.5.22
